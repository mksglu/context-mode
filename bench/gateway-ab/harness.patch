diff --git a/scripts/e2e/oss-arms-lib.mjs b/scripts/e2e/oss-arms-lib.mjs
new file mode 100644
index 00000000..ecbd3532
--- /dev/null
+++ b/scripts/e2e/oss-arms-lib.mjs
@@ -0,0 +1,292 @@
+// scripts/e2e/oss-arms-lib.mjs — the pure half of the OSS-plugin arms of start-cost-ab (--arms mode).
+//
+// Arms: `plain` (Claude Code alone, "direct" is an alias), `v1` and `v2` (Claude Code with an OSS context-mode plugin
+// tree loaded by --plugin-dir and its own MCP server declared in a strict map), and `gateway` (Claude Code through the
+// deployed gateway, one disposable tenant per workload). An arm counts only when the run's own stream-json `init`
+// event (and, for the gateway, the gateway's per-call record) shows that arm, never from model prose.
+// Cost: list price on the token counts of the session's `result` event, per model (`usdFromResult`); the client's
+// total_cost_usd is kept beside it. Output: the evidence file, schema context-mode.benchmark-evidence/2.
+// NO REGEX. NO TRUNCATION. Nothing here reads the network or the disk.
+import { pairedPct, pairedExtras } from "./start-cost-ab-lib.mjs";
+
+export const SCHEMA = "context-mode.benchmark-evidence/2";
+export const ARM_IDS = Object.freeze(["plain", "v1", "v2", "gateway"]);
+export const PLUGIN_ARMS = Object.freeze(["v1", "v2"]);
+
+/** The price table of the published evidence file (USD per million tokens, as of 2026-09-29). */
+export const PRICES = Object.freeze({
+  aliases: Object.freeze({ "claude-haiku-4-5-20251001": "claude-haiku-4-5" }),
+  as_of: "2026-09-29",
+  models: Object.freeze({
+    "claude-haiku-4-5": Object.freeze({ in: 1, out: 5, cr: 0.1, cw5: 1.25, cw1h: 2 }),
+    "claude-opus-5-5": Object.freeze({ in: 4, out: 20, cr: 0.2, cw5: 5, cw1h: 8 }),
+  }),
+  source_url: "https://www.anthropic.com/pricing",
+  unit: "USD per million tokens",
+});
+
+export class FailClosed extends Error {
+  constructor(code, msg) { super(code + ": " + msg); this.code = code; }
+}
+
+/** "direct,v1,v2" → ["plain","v1","v2"]. Unknown or repeated ids throw. */
+export function parseArms(spec) {
+  const out = [];
+  for (const raw of String(spec || "").split(",")) {
+    const s = raw.trim();
+    if (!s) continue;
+    const id = s === "direct" ? "plain" : s;
+    if (ARM_IDS.indexOf(id) < 0) throw new FailClosed("unknown-arm", s);
+    if (out.indexOf(id) >= 0) throw new FailClosed("repeated-arm", s);
+    out.push(id);
+  }
+  if (out.indexOf("plain") < 0) throw new FailClosed("no-baseline", "the arms must include plain (direct): every arm is compared with it");
+  if (out.length < 2) throw new FailClosed("too-few-arms", String(spec));
+  return out;
+}
+
+/** Arm order of cycle c: the arm list rotated left by c mod k (k arms). For direct,v1,v2: c%3=0 direct,v1,v2;
+ *  =1 v1,v2,direct; =2 v2,direct,v1 — the order the pre-registration fixes. */
+export function cycleOrder(arms, c) {
+  const k = arms.length, s = ((c % k) + k) % k;
+  return arms.slice(s).concat(arms.slice(0, s));
+}
+
+/** Bridge pair order: pair 1 plain first, pair 2 gateway first, alternating after that. */
+export function bridgeOrder(i) { return i % 2 === 1 ? ["plain", "gateway"] : ["gateway", "plain"]; }
+
+/** The canonical price key of a model id, or null when the table does not hold it. */
+export function priceKey(model, prices = PRICES) {
+  const m = String(model || "");
+  if (prices.models[m]) return m;
+  const a = prices.aliases[m];
+  return a && prices.models[a] ? a : null;
+}
+
+/** The strict MCP map for a plugin arm, from the plugin's OWN manifest (.claude-plugin/plugin.json): its one declared
+ *  server with ${CLAUDE_PLUGIN_ROOT} filled in. More or fewer than one server throws. */
+export function pluginMcpMap(manifest, dir) {
+  const servers = manifest && manifest.mcpServers;
+  const names = servers && typeof servers === "object" ? Object.keys(servers) : [];
+  if (names.length !== 1) throw new FailClosed("plugin-manifest", "expected exactly one MCP server in the plugin manifest, found " + names.length);
+  const name = names[0], s = servers[name];
+  if (!s || typeof s.command !== "string" || !Array.isArray(s.args)) throw new FailClosed("plugin-manifest", "server " + name + " has no command/args");
+  const fill = (x) => String(x).split("${CLAUDE_PLUGIN_ROOT}").join(dir);
+  const entry = { command: fill(s.command), args: s.args.map(fill) };
+  if (s.env && typeof s.env === "object") entry.env = Object.fromEntries(Object.entries(s.env).map(([k, v]) => [k, fill(v)]));
+  return { server: name, prefix: "mcp__" + name + "__", map: { mcpServers: { [name]: entry } } };
+}
+
+/** Parse a stream-json stdout into the parts the harness uses. Assistant messages are de-duplicated by message.id:
+ *  content takes the LAST sighting, usage the FIRST. */
+export function parseStream(stdout) {
+  let init = null, result = null; const results = [];
+  const byId = new Map(); const order = []; const rate = [];
+  for (const line of String(stdout || "").split("\n")) {
+    let j = null; try { j = JSON.parse(line); } catch { continue; }
+    if (!j || typeof j !== "object") continue;
+    rate.push(j);
+    if (j.type === "system" && j.subtype === "init" && !init) init = j;
+    if (j.type === "result") { result = j; results.push(j); }
+    if (j.type === "assistant" && j.message && j.message.id) {
+      const id = j.message.id;
+      if (!byId.has(id)) { byId.set(id, { id, model: j.message.model || null, main: !j.parent_tool_use_id, usage: j.message.usage || null, content: j.message.content || [] }); order.push(id); }
+      else byId.get(id).content = j.message.content || byId.get(id).content;
+    }
+  }
+  const messages = order.map((id) => byId.get(id));
+  const tools = {};
+  for (const m of messages) for (const b of m.content || []) if (b && b.type === "tool_use") tools[b.name] = (tools[b.name] || 0) + 1;
+  return { init, result, results, messages, tools, events: rate };
+}
+
+/** List-price USD of a session from its result event: per model in modelUsage, each at its own price. A cache write
+ *  is split 5m/1h only when the event has a single model and its usage.cache_creation split adds up; otherwise it is
+ *  `cwx`, priced at 1h (usd) and at 5m (usd_low). A model outside the table throws (fail closed). */
+export function usdFromResult(result, prices = PRICES) {
+  if (!result || result.type !== "result") return null;
+  const mu = result.modelUsage;
+  if (!mu || typeof mu !== "object" || Object.keys(mu).length === 0) return { usd: null, usd_low: null, calls: null, why: "no_model_usage" };
+  const names = Object.keys(mu);
+  const calls = { in: [], cr: [], cw5: [], cw1h: [], cwx: [], out: [], model: [], models: [] };
+  let usd = 0, low = 0;
+  for (const name of names) {
+    const u = mu[name] || {};
+    const key = priceKey(u.canonicalModel, prices) || priceKey(name, prices);
+    if (!key) throw new FailClosed("unknown-model", "a call ran on " + name + ", which is not in the price table");
+    const p = prices.models[key];
+    const n = (x) => { const v = Number(x); if (!Number.isFinite(v)) throw new FailClosed("bad-usage", name + " has a non-numeric token field"); return v; };
+    const tin = n(u.inputTokens), tout = n(u.outputTokens), tcr = n(u.cacheReadInputTokens), tcw = n(u.cacheCreationInputTokens);
+    let w5 = 0, w1 = 0, wx = tcw;
+    const cc = result.usage && result.usage.cache_creation;
+    if (names.length === 1 && cc && typeof cc === "object") {
+      const a = Number(cc.ephemeral_5m_input_tokens), b = Number(cc.ephemeral_1h_input_tokens);
+      if (Number.isFinite(a) && Number.isFinite(b) && a + b === tcw) { w5 = a; w1 = b; wx = 0; }
+    }
+    if (calls.models.indexOf(key) < 0) calls.models.push(key);
+    calls.model.push(calls.models.indexOf(key));
+    calls.in.push(tin); calls.cr.push(tcr); calls.cw5.push(w5); calls.cw1h.push(w1); calls.cwx.push(wx); calls.out.push(tout);
+    const base = tin * p.in + tout * p.out + tcr * p.cr + w5 * p.cw5 + w1 * p.cw1h;
+    usd += (base + wx * p.cw1h) / 1e6;
+    low += (base + wx * p.cw5) / 1e6;
+  }
+  if (calls.cwx.every((x) => x === 0)) delete calls.cwx;
+  return { usd, usd_low: low, calls, why: null };
+}
+
+const isBuiltin = (p) => p && p.path === "builtin";
+
+/**
+ * ARM RESOLUTION from the run's own init event and assistant messages. Returns { ok, why: [...], evidence }.
+ *   plain, gateway: no MCP server, no mcp__ tool, no plugin other than the client's builtins;
+ *   v1, v2: exactly the declared server, connected, at least one tool with its prefix, no other mcp__ tool, and the
+ *           one non-builtin plugin is context-mode at the arm's dir with the manifest's version;
+ *   every arm: the client version as pinned, every main-thread assistant message on the pinned model, and not logged
+ *           out (a $0 client total with tokens). The gateway's per-call record is checked by the runner (async).
+ */
+export function resolveArm({ arm, spec, parsed, clientVersion, model }) {
+  const why = [];
+  const init = parsed && parsed.init;
+  if (!init) return { ok: false, why: ["no-init-event"], evidence: null };
+  const tools = Array.isArray(init.tools) ? init.tools : [];
+  const mcp = Array.isArray(init.mcp_servers) ? init.mcp_servers : [];
+  const plugins = Array.isArray(init.plugins) ? init.plugins.filter((p) => !isBuiltin(p)) : [];
+  const mcpTools = tools.filter((t) => String(t).indexOf("mcp__") === 0);
+  const mains = (parsed.messages || []).filter((m) => m.main);
+  const mainModels = [...new Set(mains.map((m) => m.model))];
+  const helperModels = [...new Set((parsed.messages || []).filter((m) => !m.main).map((m) => m.model))];
+  const evidence = {
+    client_version: init.claude_code_version || null,
+    tools_total: tools.length,
+    mcp_servers: mcp.map((s) => ({ name: s.name, status: s.status })),
+    mcp_tools: mcpTools,
+    plugins: plugins.map((p) => ({ name: p.name, version: p.version || null, source: p.source || null, at_arm_dir: !!(spec && spec.dir && p.path === spec.dir) })),
+    main_models: mainModels,
+    helper_models: helperModels,
+  };
+  if (String(init.claude_code_version || "") !== String(clientVersion)) why.push("client-version " + init.claude_code_version + " != " + clientVersion);
+  if (mainModels.length === 0) why.push("no-main-model-message");
+  for (const m of mainModels) if (m !== model && !(priceKey(m) && priceKey(m) === priceKey(model))) why.push("model-drift " + m);
+  const r = parsed.result;
+  if (r && Number(r.total_cost_usd) === 0) {
+    const mu = r.modelUsage || {};
+    const tok = Object.values(mu).reduce((s, u) => s + Number(u.inputTokens || 0) + Number(u.outputTokens || 0) + Number(u.cacheReadInputTokens || 0) + Number(u.cacheCreationInputTokens || 0), 0);
+    if (tok > 0) why.push("logged-out (client total 0 with tokens)");
+  }
+  if (arm === "plain" || arm === "gateway") {
+    if (mcp.length !== 0) why.push("mcp-server-present");
+    if (mcpTools.length !== 0) why.push("mcp-tool-present");
+    if (plugins.length !== 0) why.push("plugin-present");
+  } else if (PLUGIN_ARMS.indexOf(arm) >= 0) {
+    if (!spec || !spec.server || !spec.prefix || !spec.dir) why.push("no-arm-spec");
+    else {
+      if (mcp.length !== 1 || mcp[0].name !== spec.server) why.push("mcp-servers " + JSON.stringify(evidence.mcp_servers) + " != [" + spec.server + "]");
+      else if (mcp[0].status !== "connected") why.push("mcp-server-status " + mcp[0].status);
+      const own = mcpTools.filter((t) => t.indexOf(spec.prefix) === 0);
+      if (own.length === 0) why.push("no-plugin-tool");
+      if (own.length !== mcpTools.length) why.push("foreign-mcp-tool");
+      evidence.plugin_tools = own;
+      if (plugins.length !== 1) why.push("plugins " + plugins.length + " != 1");
+      else {
+        const p = plugins[0];
+        if (p.name !== "context-mode") why.push("plugin-name " + p.name);
+        if (p.path !== spec.dir) why.push("plugin-path-not-arm-dir");
+        if (String(p.version || "") !== String(spec.version || "")) why.push("plugin-version " + p.version + " != " + spec.version);
+      }
+    }
+  } else why.push("unknown-arm " + arm);
+  return { ok: why.length === 0, why, evidence };
+}
+
+/** True when a run hit a rate limit (status fields only; never the answer text). */
+export function rateLimited(events) {
+  for (const j of events || []) if (j && (Number(j.api_error_status) === 429 || Number(j.error_status) === 429)) return true;
+  return false;
+}
+
+/** The fields of a run record that may be published: no tenant, session, prompt, answer, path, or argv. */
+export const PUBLIC_FIELDS = Object.freeze(["w", "cycle", "arm", "role", "attempt", "order", "position", "usd", "usd_low", "usd_client", "client_gap_pct", "client_gap_flag",
+  "calls", "calls_from", "success", "turns", "exit", "timed_out", "rate_limited", "result_subtype", "budget_hit", "tools", "plugin_tool_calls", "resolution", "plugin",
+  "client_version", "model", "harness_commit", "void_reason", "error", "ms", "gateway_record", "flags_before", "flags_after", "gw_version_before", "gw_version_after"]);
+export function publicRecord(r) {
+  const o = {};
+  for (const k of PUBLIC_FIELDS) if (r[k] !== undefined) o[k] = r[k];
+  return o;
+}
+
+const fin = (x) => x !== null && x !== undefined && Number.isFinite(Number(x));
+const mean = (xs) => (xs.length ? xs.reduce((s, x) => s + x, 0) / xs.length : null);
+
+function armBlock(r) {
+  if (!r) return null;
+  const b = { usd: r.usd, usd_client: r.usd_client, usd_recomputed: r.usd, success: r.success, turns: r.turns, calls: r.calls, calls_from: r.calls_from,
+    coverage: r.calls ? { calls: r.calls.in.length, of: r.calls.in.length, sum_complete: true } : null, tools: r.tools, resolution: r.resolution };
+  if (r.usd_low !== undefined && r.usd_low !== r.usd) b.usd_recomputed_low = r.usd_low;
+  if (r.client_gap_flag) b.client_gap_pct = r.client_gap_pct;
+  if (r.plugin) b.plugin = r.plugin;
+  if (r.plugin_tool_calls !== undefined) b.plugin_tool_calls = r.plugin_tool_calls;
+  if (r.gateway_record) b.gateway_record = r.gateway_record;
+  for (const k of ["timed_out", "rate_limited", "budget_hit", "result_subtype"]) if (r[k]) b[k] = r[k];
+  return b;
+}
+
+function contrast(base, arm) {
+  const t = pairedPct(base, arm), x = pairedExtras(base, arm);
+  return { n: t.n, pct: t.pct, pct_ci95: t.pct_ci95, verdict: t.verdict, mean_diff: t.mean_diff, median_diff: x.median_diff, wins: x.gw_wins, losses: x.plain_wins, ties: x.ties };
+}
+
+/** The evidence document. `runs` are the harness's full records; only measured, non-void runs enter `pairs`. */
+export function buildEvidence({ runs, workloads, arms, labels, meta }) {
+  const out = [];
+  for (const w of workloads) {
+    const measured = runs.filter((r) => r.w === w && r.role === "measured");
+    const cycles = [...new Set(measured.map((r) => r.cycle))].sort((a, b) => a - b);
+    const pairs = cycles.map((c) => {
+      const p = { pair: c, order: (measured.find((r) => r.cycle === c) || {}).order || null };
+      for (const a of arms) p[a] = armBlock(measured.find((r) => r.cycle === c && r.arm === a));
+      return p;
+    });
+    const col = (a) => pairs.map((p) => (p[a] && fin(p[a].usd) ? Number(p[a].usd) : null));
+    const analysis = { n: pairs.length };
+    for (const a of arms) {
+      const rs = pairs.map((p) => p[a]).filter(Boolean);
+      analysis[a + "_usd_mean"] = mean(rs.filter((b) => fin(b.usd)).map((b) => Number(b.usd)));
+      analysis["success_" + a] = rs.filter((b) => b.success === true).length + "/" + rs.length;
+      if (a !== "plain") analysis[a] = contrast(col("plain"), col(a));
+    }
+    if (arms.indexOf("v1") >= 0 && arms.indexOf("v2") >= 0) analysis.v2_vs_v1 = { secondary: true, ...contrast(col("v1"), col("v2")) };
+    const voids = runs.filter((r) => r.w === w && r.role === "void").length;
+    const bridge = runs.filter((r) => r.w === w && r.role === "bridge");
+    const doc = { id: w, label: labels[w] || w, pairs_planned: meta.pairs_planned, invalid_attempts: voids, analysis, pairs };
+    if (bridge.length) {
+      const bi = [...new Set(bridge.map((r) => r.cycle))].sort((a, b) => a - b);
+      doc.bridge = bi.map((c) => ({ pair: c, plain: armBlock(bridge.find((r) => r.cycle === c && r.arm === "plain")), gateway: armBlock(bridge.find((r) => r.cycle === c && r.arm === "gateway")) }));
+    }
+    out.push(doc);
+  }
+  return {
+    schema: SCHEMA,
+    analysis_method: "Every valid measured cycle, no outlier dropped, failures included. For each arm against plain in the same cycle: % = mean(arm - plain) / mean(plain), with the 95% t interval. Verdict: \"less\" when the whole interval is below zero, \"more\" when above, else \"same\". Wins: cycles where the arm cost less than plain. v2_vs_v1 is secondary.",
+    arms: Object.fromEntries(arms.map((a) => [a, meta.arm_text[a]])),
+    client: "Claude Code " + meta.client_version,
+    model: meta.model,
+    cost_basis: "Cost in US dollars at API list price: list price applied to the token counts in each session's result event, per model (modelUsage). Cache writes whose lifetime the event does not split are priced at the 1 hour rate (usd) and the 5 minute rate (usd_recomputed_low). Claude Code's own total is usd_client; a gap above 1% is flagged. Gateway arm: the gateway's per-call record for the session, hidden calls included. The runs used a claude.ai login, which has no per-token invoice: a list-price equivalent.",
+    coverage: { arms: runs.filter((r) => r.role === "measured").length },
+    date: meta.date,
+    harness: "start-cost-ab --arms",
+    harness_commit: meta.harness_commit,
+    workload_source: meta.workload_source,
+    plugins: meta.plugins,
+    legend: {
+      "calls_from.result_event_model_usage": "the session's result event, one entry per model (modelUsage), not per call",
+      "col.cr": "cache read tokens", "col.cw1h": "cache write tokens, 1 hour lifetime", "col.cw5": "cache write tokens, 5 minute lifetime",
+      "col.cwx": "cache write tokens whose lifetime the event did not split: usd prices them at 1 hour, usd_recomputed_low at 5 minutes",
+      "col.in": "input tokens not read from or written to the cache", "col.out": "output tokens",
+      "resolution": "what the run's own init event showed: MCP servers, mcp__ tools, non-builtin plugins, main and helper models; the gateway arm adds the gateway's per-call record for the session",
+    },
+    prices: PRICES,
+    warmup_pairs: meta.warmup,
+    withheld: "prompt and answer text, session ids, tenant ids, gateway host, local paths, credentials, raw transcripts",
+    workloads: out,
+  };
+}
diff --git a/scripts/e2e/oss-arms-lib.test.mjs b/scripts/e2e/oss-arms-lib.test.mjs
new file mode 100644
index 00000000..f88eccff
--- /dev/null
+++ b/scripts/e2e/oss-arms-lib.test.mjs
@@ -0,0 +1,101 @@
+// scripts/e2e/oss-arms-lib.test.mjs — the pure half of the OSS-plugin arms. No regex, no truncation.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseArms, cycleOrder, bridgeOrder, pluginMcpMap, parseStream, usdFromResult, resolveArm, publicRecord, buildEvidence, FailClosed } from "./oss-arms-lib.mjs";
+
+test("arms: direct is plain, plain is required, unknown and repeated ids throw", () => {
+  assert.deepEqual(parseArms("direct,v1,v2"), ["plain", "v1", "v2"]);
+  assert.throws(() => parseArms("v1,v2"), FailClosed);
+  assert.throws(() => parseArms("direct,v3"), FailClosed);
+  assert.throws(() => parseArms("direct,plain"), FailClosed);
+});
+
+test("cycle order is the pre-registered rotation", () => {
+  const a = ["plain", "v1", "v2"];
+  assert.deepEqual(cycleOrder(a, 0), ["plain", "v1", "v2"]);
+  assert.deepEqual(cycleOrder(a, 1), ["v1", "v2", "plain"]);
+  assert.deepEqual(cycleOrder(a, 2), ["v2", "plain", "v1"]);
+  assert.deepEqual(cycleOrder(a, 3), ["plain", "v1", "v2"]);
+  assert.deepEqual(bridgeOrder(1), ["plain", "gateway"]);
+  assert.deepEqual(bridgeOrder(2), ["gateway", "plain"]);
+});
+
+test("the strict MCP map comes from the plugin's own manifest with the root filled in", () => {
+  const m = pluginMcpMap({ mcpServers: { "context-mode": { command: "node", args: ["${CLAUDE_PLUGIN_ROOT}/server.mjs", "--agent", "claude-code"] } } }, "/p");
+  assert.equal(m.server, "context-mode");
+  assert.equal(m.prefix, "mcp__context-mode__");
+  assert.deepEqual(m.map, { mcpServers: { "context-mode": { command: "node", args: ["/p/server.mjs", "--agent", "claude-code"] } } });
+  assert.throws(() => pluginMcpMap({ mcpServers: {} }, "/p"), FailClosed);
+});
+
+test("stream parse: duplicate assistant events keep the first usage and the last content", () => {
+  const lines = [
+    { type: "system", subtype: "init", session_id: "s" },
+    { type: "assistant", message: { id: "m1", model: "x", usage: { output_tokens: 1 }, content: [] } },
+    { type: "assistant", message: { id: "m1", model: "x", usage: { output_tokens: 99 }, content: [{ type: "tool_use", name: "Bash" }] } },
+    { type: "result", total_cost_usd: 1 },
+  ].map((j) => JSON.stringify(j)).join("\n");
