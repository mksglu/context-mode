+const ROOT = mkdtempSync(join(tmpdir(), "cm-ossab-"));
+const META = {};
+for (const w of WLS) META[w] = WORK[w].fx(join(ROOT, "tpl-" + w));
+let spent = runs.reduce((s, r) => s + Math.max(Number(r.usd) || 0, Number(r.usd_client) || 0), 0);
+let perRun = 0.05, stopped = null;
+
+// ── one session ─────────────────────────────────────────────────────────────────────────────────────────────
+async function runOne({ w, arm, cycle, role, attempt, order, position }) {
+  const dir = join(ROOT, w + "-" + role + "-" + cycle + "-" + attempt + "-" + arm);
+  const cp = spawnSync("cp", ["-R", join(ROOT, "tpl-" + w), dir]);
+  if (cp.status !== 0) throw new FailClosed("fixture-copy", w);
+  const cfg = mkdtempSync(join(tmpdir(), "cm-ossab-cfg-"));
