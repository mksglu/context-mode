+  if (!ADMIN) throw new FailClosed("no-admin-key", "without the admin key x-cm-tenant is ignored and traffic lands on the owner tenant");
+  for (const w of WLS) {
+    const t = "t_ossab_" + STAMP + "_" + w;
+    if (isOwnerTenant(t)) throw new FailClosed("owner-tenant", "refused");
