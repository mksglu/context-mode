+}
+const done = (w, role, cycle) => runs.some((r) => r.w === w && r.role === role && r.cycle === cycle && r.cycle_done === true);
+
+async function runCycle(w, role, cycle, order) {
+  for (let attempt = 1; attempt <= 2; attempt++) {
+    const recs = [];
