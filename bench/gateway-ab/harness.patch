+  for (const k of Object.keys(env)) if (k.indexOf("CLAUDE_CODE_") === 0 || k === "CLAUDECODE" || k === "CLAUDE_PID" || k === "AI_AGENT" || k === "CLAUDE_EFFORT") delete env[k];
+  delete env.ANTHROPIC_BASE_URL; delete env.ANTHROPIC_CUSTOM_HEADERS;
+  env.ENABLE_CLAUDEAI_MCP_SERVERS = "false"; env.CLAUDE_CODE_DISABLE_AUTO_MEMORY = "1"; env.CLAUDE_CODE_DISABLE_CLAUDE_MDS = "1";
+  if (arm === "gateway") { env.ANTHROPIC_BASE_URL = GW; env.ANTHROPIC_CUSTOM_HEADERS = headerLines(disposableHeaders({ adminKey: ADMIN, tenant: TENANTS[w] })); }
+  const spec = SPECS[arm] || null;
+  const args = ["-p", WORK[w].prompt, "--model", MODEL, "--output-format", "stream-json", "--verbose", "--max-turns", MAX_TURNS,
+    "--permission-mode", "bypassPermissions", "--max-budget-usd", BUDGET, "--strict-mcp-config"];
+  if (spec) args.push("--plugin-dir", spec.dir, "--mcp-config", JSON.stringify(spec.map));
+  else args.push("--mcp-config", JSON.stringify({ mcpServers: {} }));
