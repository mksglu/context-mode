+const ARMS = parseArms(need("--arms"));
+const MODEL = need("--model");
+const CLAUDE = need("--claude");
+const CLIENT_VERSION = need("--client-version");
+const OUT = need("--out");
+const PRIV = need("--private");
+const N = Number(arg("--n", "8"));
+const WARMUP = Number(arg("--warmup", "1"));
+const BRIDGE = Number(arg("--bridge", "0"));
