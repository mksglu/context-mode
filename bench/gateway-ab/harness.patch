+}
+
+// ── files ───────────────────────────────────────────────────────────────────────────────────────────────────
+mkdirSync(PRIV, { recursive: true });
+mkdirSync(join(PRIV, "transcripts"), { recursive: true });
+const LEDGER = join(PRIV, "runs.jsonl");
+const runs = [];
+if (RESUME && existsSync(LEDGER)) for (const l of readFileSync(LEDGER, "utf8").split("\n")) { if (!l) continue; try { runs.push(JSON.parse(l)); } catch {} }
