+function gitOut(dir, args) { const r = spawnSync("git", ["-C", dir, ...args], { encoding: "utf8" }); if (r.status !== 0) throw new FailClosed("git", dir + " " + args.join(" ") + ": " + r.stderr); return String(r.stdout).trim(); }
