+for (const a of PLUGIN_ARMS) if (ARMS.indexOf(a) >= 0) SPECS[a] = pluginSpec(a, arg("--" + a + "-dir", ""));
+const CV0 = clientVersion();
+if (CV0 !== CLIENT_VERSION) throw new FailClosed("client-version", CV0 + " != pinned " + CLIENT_VERSION);
+const HARNESS_COMMIT = gitOut(REPO, ["rev-parse", "HEAD"]);
+const HARNESS_DIRTY = gitOut(REPO, ["status", "--porcelain", "--", "scripts/e2e"]);
