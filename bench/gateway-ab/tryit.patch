+// scripts/e2e/tryit-workloads.mjs — THE SIX README "TRY IT" PROMPTS (docs/benchmarks/try-it/prereg.md on the OSS repo,
+// branch v2-design, commit f924eda2). Same shape as short-workloads.mjs: a fixture builder, the verbatim prompt, and a
+// task oracle `ok(dir, meta, answer, parsed)`. Every fixture is an EMPTY cwd: the prompts fetch, clone or build what
+// they need. `why(...)` returns the oracle's reason, so a fail is explained in the private record.
+// NO REGEX. NO TRUNCATION. Fail closed: an oracle that cannot find its reference answers false.
+import { spawnSync } from "node:child_process";
+import { mkdirSync } from "node:fs";
+import { join } from "node:path";
+import { largeJsonTranscriptWhy } from "./oss-arms-lib.mjs";
+
+const empty = (dir) => { mkdirSync(dir, { recursive: true }); return {}; };
+// Client-visible tool_use blocks plus (gateway arm, amendment 1) the edge calls in the gateway per-call record.
+export const toolCalls = (p) => Object.values((p && p.tools) || {}).reduce((s, n) => s + n, 0) + (Number(p && p.edge_calls) || 0);
+
+/** Completion check (prereg): end_turn, at least one tool call, a non-empty final answer. Not a quality check. */
+export function completionWhy(dir, m, answer, p) {
+  if (!p || !p.result) return "no-result-event";
+  if (p.result.is_error === true || p.result.subtype !== "success") return "result-" + p.result.subtype;
+  if (p.result.stop_reason !== undefined && p.result.stop_reason !== null && p.result.stop_reason !== "end_turn") return "stop-" + p.result.stop_reason;
+  if (toolCalls(p) < 1) return "no-tool-call";
+  if (String(answer || "").trim().length === 0) return "empty-answer";
+  return "ok";
+}
+
+// ── large-json (prereg amendment 1): the hidden record as the session's OWN tool_result showed it ─────────────
+// The first run read the record back from disk and failed every arm that built the data in memory
+// ("no-served-data-on-disk"). The reference is now the record object JSON-parsed from the tool_result that served or
+// generated index 13000 (oss-arms-lib.mjs largeJsonTranscriptWhy). Success = every scalar leaf of that record appears
+// whole in the final answer. No such tool_result: "no-record-in-tool-result" (fail closed), never a guess.
+function largeJsonWhy(dir, m, answer, p) {
+  const c = completionWhy(dir, m, answer, p);
+  if (c !== "ok" && c !== "no-tool-call") return c;
+  return largeJsonTranscriptWhy(p && p.events, answer, 13000);
+}
+
+// ── git-history: the top author of the last 500 commits, from a reference clone pinned at harness start ──────
+function fxReact(dir) {
+  mkdirSync(dir, { recursive: true });
+  const ref = dir + "-ref";
+  const c = spawnSync("git", ["clone", "-q", "--bare", "--filter=blob:none", "--depth", "600", "https://github.com/facebook/react", ref], { encoding: "utf8" });
+  if (c.status !== 0) throw new Error("reference clone: " + c.stderr);
+  const head = String(spawnSync("git", ["-C", ref, "rev-parse", "HEAD"], { encoding: "utf8" }).stdout).trim();
+  const sl = spawnSync("git", ["-C", ref, "shortlog", "-sn", "--max-count=500", "HEAD"], { encoding: "utf8" });
+  if (sl.status !== 0) throw new Error("shortlog: " + sl.stderr);
+  const rows = String(sl.stdout).split("\n").filter(Boolean).map((l) => { const t = l.trim(); const k = t.indexOf("\t"); return { n: Number(t.slice(0, k)), name: t.slice(k + 1).trim() }; });
+  if (rows.length === 0 || !(rows[0].n > 0)) throw new Error("shortlog empty");
+  const top = rows.filter((r) => r.n === rows[0].n).map((r) => r.name);
+  return { pinned: head, top, top_commits: rows[0].n };
+}
+function gitHistoryWhy(dir, m, answer, p) {
+  const c = completionWhy(dir, m, answer, p);
+  if (c !== "ok") return c;
+  const s = String(answer || "");
+  return m.top.some((n) => s.indexOf(n) >= 0) ? "ok" : "top-author-not-named";
+}
+
+const W = (prompt, why, fx = empty) => ({ fx, prompt, why, ok: (dir, m, a, p) => why(dir, m, a, p) === "ok" });
+export const TRYIT_WORK = {
+  "repo-research": W("Research https://github.com/modelcontextprotocol/servers — architecture, tech stack, top contributors, open issues, and recent activity.", completionWhy),
+  "git-history": W("Clone https://github.com/facebook/react and analyze the last 500 commits: top contributors, commit frequency by month, and most changed files.", gitHistoryWhy, fxReact),
+  "web-scrape": W("Fetch the Hacker News front page, extract all posts with titles, scores, and domains. Group by domain.", completionWhy),
+  "large-json": W("Create a local server that returns a 7.5 MB JSON with 20,000 records and a secret hidden at index 13000. Fetch the endpoint, find the hidden record, and show me exactly what's in it.", largeJsonWhy),
+  "docs-search": W("Fetch the React useEffect docs, index them, and find the cleanup pattern with code examples.", completionWhy),
+  "session-continuity": W("Start a multi-step task: Create a REST API with Express — add routes, tests, and error handling.", completionWhy),
+};
+export const TRYIT_LABELS = { "repo-research": "Repo research (MCP servers)", "git-history": "Git history (react, 500 commits)", "web-scrape": "Web scrape (Hacker News)",
+  "large-json": "Large JSON (7.5 MB, 20,000 records)", "docs-search": "Docs search (useEffect cleanup)", "session-continuity": "Session continuity (Express API), demonstration only" };
