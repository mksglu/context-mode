{
  "hooks": [
    {
      "action": {
        "command": "node hook.mjs --agent kiro",
        "type": "command"
      },
      "enabled": true,
      "name": "context-mode-SessionStart",
      "timeout": 5,
      "trigger": "SessionStart"
    },
    {
      "action": {
        "command": "node hook.mjs --agent kiro",
        "type": "command"
      },
      "enabled": true,
      "name": "context-mode-UserPromptSubmit",
      "timeout": 5,
      "trigger": "UserPromptSubmit"
    },
    {
      "action": {
        "command": "node hook.mjs --agent kiro",
        "type": "command"
      },
      "enabled": true,
      "matcher": "@mcp",
      "name": "context-mode-PreToolUse-mcp",
      "timeout": 5,
      "trigger": "PreToolUse"
    },
    {
      "action": {
        "command": "node hook.mjs --agent kiro",
        "type": "command"
      },
      "enabled": true,
      "matcher": "shell",
      "name": "context-mode-PreToolUse-shell",
      "timeout": 5,
      "trigger": "PreToolUse"
    },
    {
      "action": {
        "command": "node hook.mjs --agent kiro",
        "type": "command"
      },
      "enabled": true,
      "matcher": "@mcp",
      "name": "context-mode-PostToolUse-mcp",
      "timeout": 5,
      "trigger": "PostToolUse"
    },
    {
      "action": {
        "command": "node hook.mjs --agent kiro",
        "type": "command"
      },
      "enabled": true,
      "matcher": "shell",
      "name": "context-mode-PostToolUse-shell",
      "timeout": 5,
      "trigger": "PostToolUse"
    }
  ],
  "version": "v1"
}
