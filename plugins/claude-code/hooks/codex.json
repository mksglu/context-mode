{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node hook.mjs --agent codex",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|apply_patch|mcp__context_mode__ctx_.*)$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node hook.mjs --agent codex",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|apply_patch|mcp__context_mode__ctx_.*)$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node hook.mjs --agent codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node hook.mjs --agent codex",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
