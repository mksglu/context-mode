    "context-mode": {
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server.mjs",
        "--agent",
        "claude-code"
      ],
      "command": "node"
    }
  },
  "name": "context-mode",
  "version": "2.1.4"
}
